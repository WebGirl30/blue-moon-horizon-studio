:root {
  --navy-950:#020817;
  --navy-900:#031127;
  --navy-850:#061a35;
  --navy-800:#08213e;
  --blue:#6eb8ff;
  --blue-2:#9bd1ff;
  --gold:#f6c65b;
  --gold-2:#dca53d;
  --cream:#f8f4eb;
  --muted:#b8c5d8;
  --line:rgba(110,184,255,.28);
  --panel:rgba(4,20,42,.78);
  --panel-2:rgba(7,29,57,.7);
  --shadow:0 22px 60px rgba(0,0,0,.35);
  --radius:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--navy-950);color:var(--cream);font-family:Inter,Segoe UI,Arial,sans-serif;line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button,input,textarea,select{font:inherit}
.site-shell{min-height:100vh;background:
  radial-gradient(circle at 75% 12%,rgba(47,118,255,.11),transparent 28%),
  linear-gradient(180deg,rgba(2,8,23,.18),var(--navy-950) 86%)}
.container{width:min(1180px,calc(100% - 36px));margin-inline:auto}
.site-header{position:sticky;top:0;z-index:1000;background:rgba(2,8,23,.73);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.05)}
.navbar{height:82px;display:grid;grid-template-columns:82px 1fr auto;align-items:center;gap:24px}
.brand-mark{width:68px;height:68px;border-radius:50%;overflow:hidden;box-shadow:0 0 28px rgba(110,184,255,.15)}
.brand-mark img{width:100%;height:100%;object-fit:cover;transform:scale(1.08)}
.nav-links{display:flex;justify-content:center;gap:30px;font-family:Georgia,'Times New Roman',serif;font-size:.98rem}
.nav-links a{position:relative;padding:8px 0;color:#edf4ff}
.nav-links a::after{content:"";position:absolute;left:50%;right:50%;bottom:0;height:2px;background:var(--gold);transition:.25s}
.nav-links a:hover::after,.nav-links a.active::after{left:0;right:0}
.nav-links a.active{color:var(--gold)}
.cta,.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:999px;border:1px solid var(--gold);padding:13px 22px;font-weight:700;transition:.25s;cursor:pointer}
.cta:hover,.btn.outline:hover{background:rgba(246,198,91,.12);transform:translateY(-2px)}
.btn.primary{background:linear-gradient(135deg,#ffd978,#eab749);color:#071224;border:none;box-shadow:0 9px 30px rgba(246,198,91,.16)}
.btn.primary:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(246,198,91,.22)}
.btn.outline{background:rgba(3,17,39,.45);color:#fff}
.menu-toggle{display:none;background:none;border:1px solid var(--line);border-radius:12px;color:white;padding:10px 12px}
.hero{position:relative;min-height:650px;display:flex;align-items:center;background:
 linear-gradient(180deg,rgba(2,8,23,.08),rgba(2,8,23,.22) 60%,#020817 100%),
 url('assets/background-blue-moon.png') center/cover no-repeat;overflow:hidden}
.hero::after{content:"";position:absolute;inset:auto 0 0;height:170px;background:linear-gradient(transparent,var(--navy-950));pointer-events:none}
.hero-inner{position:relative;z-index:2;text-align:center;padding:70px 0 110px}
.eyebrow{letter-spacing:.33em;text-transform:uppercase;font-size:.76rem;color:#d5e5fb;font-weight:700}
.hero h1,.page-hero h1,.section-title{font-family:Georgia,'Times New Roman',serif;font-weight:500;letter-spacing:-.025em}
.hero h1{font-size:clamp(3.5rem,8vw,7.2rem);line-height:.83;margin:22px 0 20px;text-shadow:0 8px 35px rgba(0,0,0,.28)}
.hero h1 .blue{color:var(--blue-2);display:block}.hero h1 .gold{color:var(--gold);font-size:.66em;text-transform:uppercase;letter-spacing:.06em;display:block;margin-top:12px}
.hero p{max-width:650px;margin:0 auto 28px;color:#e3edf9;font-size:1.08rem}
.hero-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}
section{padding:82px 0}
.section-heading{text-align:center;margin-bottom:36px}.section-heading .eyebrow{color:var(--gold)}
.section-title{font-size:clamp(2.1rem,4vw,3.35rem);line-height:1.08;margin:8px 0 10px}
.section-subtitle{max-width:700px;margin:0 auto;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:linear-gradient(180deg,rgba(8,33,62,.86),rgba(3,17,39,.92));border:1px solid var(--line);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);transition:.28s}
.card:hover{transform:translateY(-5px);border-color:rgba(246,198,91,.5)}
.icon-circle{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px;border:1px solid var(--gold);color:var(--gold);font-size:1.7rem;box-shadow:0 0 24px rgba(246,198,91,.09)}
.card h3{font-family:Georgia,'Times New Roman',serif;font-size:1.45rem;margin:0 0 8px}.card p{color:var(--muted);margin:0}
.service-card{text-align:center}
.dark-section{background:radial-gradient(circle at 50% 0,rgba(32,94,170,.11),transparent 52%)}
.about-grid{display:grid;grid-template-columns:1fr 1.1fr .55fr;gap:32px;align-items:center}
.visual-card{min-height:360px;border:1px solid rgba(246,198,91,.55);border-radius:34px;background:radial-gradient(circle at 60% 25%,rgba(246,198,91,.12),transparent 30%),linear-gradient(145deg,#061b38,#020a17);display:grid;place-items:center;padding:30px;position:relative;overflow:hidden}
.fake-laptop{width:82%;aspect-ratio:16/10;border:9px solid #0a0f19;border-radius:14px;background:linear-gradient(145deg,#061939,#0e3870);display:grid;place-items:center;box-shadow:0 30px 45px rgba(0,0,0,.38);transform:perspective(800px) rotateY(-7deg) rotateX(2deg)}
.fake-laptop img{width:37%;border-radius:50%;box-shadow:0 0 35px rgba(110,184,255,.16)}
.about-copy .eyebrow{text-align:left;color:var(--gold)}.about-copy .section-title{text-align:left;margin-bottom:18px}.about-copy p{color:var(--muted)}
.quote-box{border-left:1px solid var(--gold);padding-left:28px;font-family:Georgia,'Times New Roman',serif;font-size:1.55rem;font-style:italic;color:#f1f5fb}.quote-mark{font-size:3rem;line-height:1;color:var(--gold)}
.portfolio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.work-card{overflow:hidden;padding:0}.work-thumb{height:220px;display:grid;place-items:center;position:relative;background:linear-gradient(145deg,#0a3264,#06152d)}
.work-thumb.website::before{content:"";width:76%;height:70%;border-radius:10px;border:7px solid #111827;background:linear-gradient(#0b2548 0 16%,#f2f4f7 16%);box-shadow:0 18px 35px rgba(0,0,0,.32)}
.work-thumb.brand::before{content:"BM";font-family:Georgia,serif;font-size:4rem;color:var(--gold);border:1px solid var(--gold);border-radius:50%;width:130px;height:130px;display:grid;place-items:center}
.work-thumb.social::before{content:"✦";font-size:5rem;color:var(--gold);width:140px;height:180px;border-radius:18px;background:linear-gradient(145deg,#0c2344,#061124);border:1px solid var(--line);display:grid;place-items:center;transform:rotate(-6deg);box-shadow:18px 20px 0 rgba(10,29,54,.55)}
.work-info{padding:20px}.work-info h3{margin:0 0 5px;font-family:Georgia,serif}.work-info span{color:var(--muted);font-size:.9rem}
.cta-strip{padding:34px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(90deg,rgba(5,24,49,.95),rgba(12,43,77,.82));display:flex;align-items:center;justify-content:space-between;gap:20px}.cta-strip h2{font-family:Georgia,serif;font-size:2rem;margin:0}.cta-strip p{margin:3px 0 0;color:var(--muted)}
.page-hero{padding:110px 0 75px;text-align:center;background:linear-gradient(180deg,rgba(2,8,23,.24),var(--navy-950)),url('assets/background-blue-moon.png') center 22%/cover no-repeat}.page-hero h1{font-size:clamp(3rem,7vw,5.8rem);margin:10px 0 6px}.page-hero p{color:var(--muted);max-width:650px;margin:auto}
.values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.value{text-align:center}.value .icon-circle{width:54px;height:54px}.value h3{margin:10px 0 5px;font-family:Georgia,serif}.value p{font-size:.92rem;color:var(--muted)}
.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.service-detail{display:grid;grid-template-columns:74px 1fr;gap:20px;align-items:start}.service-detail .icon-circle{margin:0}.service-detail h3{font-family:Georgia,serif;font-size:1.55rem;margin:0 0 7px}.service-detail ul{margin:12px 0 0;padding-left:18px;color:var(--muted)}
.filters{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}.filter-btn{border:1px solid var(--line);background:rgba(8,33,62,.7);color:#dbe8fa;border-radius:999px;padding:9px 18px;cursor:pointer}.filter-btn.active,.filter-btn:hover{background:var(--gold);color:#081324;border-color:var(--gold)}
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch}.price-card{position:relative}.price-card.featured{border-color:var(--gold);transform:translateY(-8px)}.badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--gold);color:#071224;border-radius:999px;padding:5px 13px;font-size:.75rem;font-weight:800}.price-card h3{font-family:Georgia,serif;font-size:1.6rem}.price{font-family:Georgia,serif;font-size:2.8rem;margin:6px 0 15px}.price-card ul{list-style:none;padding:0;margin:18px 0 25px}.price-card li{padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06);color:var(--muted)}.price-card li::before{content:"✦";color:var(--gold);margin-right:10px}
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px}.contact-list{display:grid;gap:15px;margin-top:28px}.contact-item{display:flex;gap:14px;align-items:flex-start}.contact-icon{width:44px;height:44px;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);flex:0 0 auto}.contact-item h4{margin:0 0 3px}.contact-item p{margin:0;color:var(--muted)}
.form-card{background:rgba(4,20,42,.88);border:1px solid var(--line);border-radius:var(--radius);padding:28px}.field{display:grid;gap:7px;margin-bottom:16px}.field label{font-size:.9rem;color:#dce7f6}.field input,.field textarea,.field select{width:100%;background:#0a2442;color:white;border:1px solid rgba(143,190,238,.2);border-radius:10px;padding:13px 14px;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--gold)}.field textarea{min-height:150px;resize:vertical}.form-status{min-height:24px;color:var(--blue-2);margin-top:10px}
.site-footer{border-top:1px solid rgba(255,255,255,.06);padding:28px 0 36px;background:#010612}.footer-grid{display:grid;grid-template-columns:100px 1fr auto;align-items:center;gap:26px}.footer-logo{width:72px;height:72px;border-radius:50%;overflow:hidden}.footer-logo img{width:100%;height:100%;object-fit:cover}.footer-links{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;font-family:Georgia,serif}.copyright{text-align:center;color:#7f90a7;font-size:.82rem;margin-top:14px}.socials{display:flex;gap:12px}.socials a{width:36px;height:36px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center}
.reveal{opacity:0;transform:translateY(22px);transition:.7s ease}.reveal.visible{opacity:1;transform:none}
@media(max-width:900px){.navbar{grid-template-columns:68px 1fr auto}.nav-links{position:absolute;left:18px;right:18px;top:88px;display:none;flex-direction:column;gap:3px;background:#06142b;border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:var(--shadow)}.nav-links.open{display:flex}.nav-links a{padding:11px}.nav-links a::after{display:none}.desktop-cta{display:none}.menu-toggle{display:block;justify-self:end}.cards,.portfolio-grid,.pricing-grid{grid-template-columns:1fr}.about-grid{grid-template-columns:1fr}.quote-box{border-left:0;border-top:1px solid var(--gold);padding:24px 0 0}.values-grid{grid-template-columns:repeat(2,1fr)}.service-grid,.contact-grid{grid-template-columns:1fr}.cta-strip{flex-direction:column;text-align:center}.footer-grid{grid-template-columns:1fr;justify-items:center}.hero{min-height:590px}.hero h1{font-size:clamp(3.1rem,13vw,5rem)}}
@media(max-width:560px){.container{width:min(100% - 24px,1180px)}.brand-mark{width:58px;height:58px}.navbar{height:72px}.hero{min-height:560px}.hero-inner{padding-top:45px}.hero p{font-size:.98rem}.hero h1 .gold{font-size:.55em}.cards{grid-template-columns:1fr}.values-grid{grid-template-columns:1fr}.service-detail{grid-template-columns:1fr}.service-detail .icon-circle{margin:0 auto}.service-detail{text-align:center}.price-card.featured{transform:none}.cta,.btn{width:100%}.hero-actions{width:min(360px,100%);margin:auto}.section-title{font-size:2.25rem}.page-hero{padding-top:80px}}

.profile-card{padding:0;background:#061b38;min-height:360px;}
.profile-photo{width:100%;height:100%;min-height:360px;object-fit:cover;object-position:center 28%;display:block;}

/* Clickable portfolio project gallery */
.project-card{cursor:pointer;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.project-card:hover,.project-card:focus-visible{transform:translateY(-5px);border-color:rgba(246,190,79,.72);box-shadow:0 18px 46px rgba(0,0,0,.3);outline:none}.work-image{width:100%;height:220px;object-fit:cover;object-position:top;display:block;border-bottom:1px solid var(--line)}.work-info p{color:var(--muted);line-height:1.55;margin:.55rem 0 .9rem}.project-tag{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--gold);margin-bottom:.45rem}.view-project{color:var(--gold)!important;font-weight:700}.project-modal{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:28px}.project-modal.open{display:flex}.project-modal-backdrop{position:absolute;inset:0;background:rgba(1,8,20,.88);backdrop-filter:blur(8px)}.project-modal-panel{position:relative;z-index:1;width:min(1120px,96vw);max-height:92vh;overflow:auto;background:linear-gradient(160deg,#071b34,#031126);border:1px solid rgba(246,190,79,.45);border-radius:24px;box-shadow:0 30px 90px rgba(0,0,0,.55);padding:30px}.project-modal-close{position:sticky;float:right;top:0;z-index:3;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:#081b33;color:#fff;font-size:1.8rem;line-height:1;cursor:pointer}.project-modal-heading h2{font:clamp(2.2rem,5vw,4rem)/1 Georgia,serif;margin:.3rem 0 .7rem}.project-modal-heading p{max-width:780px;color:var(--muted);line-height:1.65}.gallery-main{margin-top:22px;background:#020a16;border:1px solid var(--line);border-radius:16px;overflow:hidden}.gallery-main img{width:100%;display:block;max-height:58vh;object-fit:contain}.gallery-thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:14px}.gallery-thumb{border:1px solid var(--line);background:rgba(8,33,62,.7);color:#dbe8fa;border-radius:12px;padding:7px;cursor:pointer;text-align:left}.gallery-thumb.active,.gallery-thumb:hover{border-color:var(--gold);box-shadow:0 0 0 1px rgba(246,190,79,.25)}.gallery-thumb img{width:100%;height:74px;object-fit:cover;object-position:top;border-radius:8px;display:block}.gallery-thumb span{display:block;font-size:.78rem;margin-top:6px;text-align:center}.project-details{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.project-details div{border:1px solid var(--line);border-radius:14px;padding:14px;background:rgba(8,33,62,.45)}.project-details strong,.project-details span{display:block}.project-details strong{color:var(--gold);margin-bottom:5px}.project-details span{color:var(--muted);line-height:1.45}.modal-open{overflow:hidden}@media(max-width:760px){.project-modal{padding:12px}.project-modal-panel{padding:20px 14px;border-radius:18px}.gallery-thumbs{grid-template-columns:repeat(2,1fr)}.project-details{grid-template-columns:1fr}.gallery-thumb img{height:90px}}

/* Video portfolio demo */
.project-video-wrap{margin-top:22px;background:#020a16;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.28)}
.project-video-wrap video{width:100%;max-height:62vh;display:block;background:#000}
